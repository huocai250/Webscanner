# WebVulnScanner 配置文件示例
# 用法： python main.py https://example.com --config scanner.cfg
# 命令行参数优先级高于本文件。

[scanner]
threads = 10
timeout = 10
retries = 2

# 负责任扫描：限速，降低目标负载
delay = 0.0
jitter = 0.0
rate = 0

# 爬虫
max_urls = 100
max_depth = 2

# 网络
verify_ssl = false
random_agent = false
# proxy = http://127.0.0.1:8080
# user_agent =

# 带外探测 canary（替换为你自己的 collaborator 域名）
canary = oob.canary.example

# v12 PoC 自动化验证
# 默认：内置应急集 + 指纹匹配的库模板；全部执行用 poc_all = true
poc_all = false
poc_only = false
# poc_dirs = pocs/custom
# poc_ids = wvs-log4shell-cve-2021-44228
# poc_tags = cve,rce
# poc_severity = critical,high

# 被动模式（只做非侵入式检测）
passive = false

# 自定义字典
# wordlist = my_dirs.txt
# subdomain_wordlist = subs.txt

# 插件目录
# plugins_dir = plugins

# 跳过的模块（逗号分隔），可用: subdomain, ports, dirbust, log4shell ...
skip = subdomain
